REPOINSIGHT_DEMO=true
REPOINSIGHT_DATA=./data
GITHUB_TOKEN=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
MAX_FILES=80
MAX_FILE_BYTES=204800
MAX_INPUT_CHARS=48000

# DeepWiki-Open sidecar (real analysis never falls back to demo)
DEEPWIKI_BASE_URL=
DEEPWIKI_PROVIDER=google
DEEPWIKI_MODEL=
# Docker sidecar: mount this app data directory and set its container root
DEEPWIKI_SHARED_ROOT=

# Optional project analysis overrides. By default reuse DeepSeek credentials from
# data/deepwiki-open/.env; never commit real keys.
PROJECT_MODEL_ENV_FILE=
PROJECT_MODEL_API_KEY=
PROJECT_MODEL_BASE_URL=
PROJECT_MODEL=
# Project analysis defaults to deepseek-v4-pro; independent of DEEPWIKI_MODEL.
DEEPWIKI_TIMEOUT_SECONDS=1200
DEEPWIKI_REVIEW_TIMEOUT_SECONDS=240

# 共享分析/阶段缓存含源码材料，勿公开此目录
PROJECT_ANALYSIS_CACHE_DIR=
PROJECT_MAX_REPORTED_TOKENS=250000

# INVESTIGATE/SYNTHESIZE only; bounded 7000–16000. Actual provider support must be verified.
PROJECT_DISCOVERY_MAX_TOKENS=12000

# Native DeepWiki webpage URL; leave empty until its separate web service is available.
DEEPWIKI_WEB_URL=

# Explicit index preparation budget, shared across one manifest build. 0 permits reuse only.
# Raising this permits code embedding calls when users generate; query embedding is separate.
CODE_INDEX_NEW_VECTOR_BUDGET=0
# Wiki enhancement is opt-in; requires the guarded sidecar --wiki-rag install.
# A changed splitter may need NEW vectors. Zero budget fails before embedding.
WIKI_RETRIEVAL_MODE=legacy
# auto dynamically fills missing vectors within one global safety cap; reuse_only never
# exceeds WIKI_RAG_MAX_NEW_VECTORS/CODE_INDEX_NEW_VECTOR_BUDGET (default 0).
WIKI_RAG_INDEX_MODE=auto
WIKI_RAG_AUTO_VECTOR_LIMIT=10000
WIKI_RAG_INDEX_CONCURRENCY=2
WIKI_RAG_INDEX_BATCH_SIZE=32
WIKI_RAG_INDEX_TIMEOUT=7200
WIKI_RAG_MODEL_CALLS=6
WIKI_RAG_ROUNDS=2
WIKI_RAG_TOOLS=20
WIKI_RAG_SEMANTIC=6
WIKI_RAG_FILES=8
WIKI_RAG_EVIDENCE=12000
WIKI_RAG_INITIAL_EVIDENCE=8000
WIKI_RAG_INPUT=18000
WIKI_RAG_OUTPUT=4000
WIKI_RAG_PAGE_LIMIT=12
# WIKI_RAG_MAX_NEW_VECTORS overrides CODE_INDEX_NEW_VECTOR_BUDGET if explicitly set.
PROJECT_SOURCE_FILES=12

# Discussion context only; conservative UTF-8 byte estimate, not exact tokenizer usage.
MEMORY_RECENT_TURNS=10
MEMORY_RECENT_TOKEN_BUDGET=4000
MEMORY_STATE_TOKEN_BUDGET=1200
MEMORY_HISTORY_TOKEN_BUDGET=2000
CHAT_INPUT_TOKEN_BUDGET=16000
CHAT_OUTPUT_TOKEN_RESERVE=2000
CHAT_MODEL_WINDOW=32768

# Optimization advisor v2: external search is opt-in; Tavily may charge credits.
OPTIMIZATION_MAX_CANDIDATES=6
OPTIMIZATION_MAX_DETAILED_DIRECTIONS=3
OPTIMIZATION_MAX_SEMANTIC_CALLS=3
OPTIMIZATION_MAX_REQUEST_ATTEMPTS=4
OPTIMIZATION_MAX_WEB_QUERIES=6
OPTIMIZATION_MAX_WEB_READS=6
OPTIMIZATION_MAX_PARALLEL_TOOLS=3
OPTIMIZATION_FOLLOWUP_ROUNDS=1
OPTIMIZATION_PLAN_OUTPUT_TOKENS=4000
OPTIMIZATION_REPORT_OUTPUT_TOKENS=10000
OPTIMIZATION_WEB_ENABLED=false
TAVILY_API_KEY=
OPTIMIZATION_WEB_REFRESH=false
