REPOCAREER_DEMO=true
REPOCAREER_DATA=./data
GITHUB_TOKEN=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
MAX_FILES=80
MAX_FILE_BYTES=204800
MAX_INPUT_CHARS=48000

# DeepWiki-Open sidecar (real analysis never falls back to demo)
DEEPWIKI_BASE_URL=
DEEPWIKI_PROVIDER=google
DEEPWIKI_MODEL=
# Docker sidecar: mount this app data directory and set its container root
DEEPWIKI_SHARED_ROOT=

# Optional resume writer overrides. By default reuse DeepSeek credentials from
# data/deepwiki-open/.env; never commit real keys.
RESUME_MODEL_ENV_FILE=
RESUME_MODEL_API_KEY=
RESUME_MODEL_BASE_URL=
RESUME_MODEL=
# Writing defaults to deepseek-v4-pro; independent of DEEPWIKI_MODEL.
RESUME_GENERATION_CALLS=16
DEEPWIKI_TIMEOUT_SECONDS=1200
DEEPWIKI_REVIEW_TIMEOUT_SECONDS=240

# 简历Harness：只保存Wiki分块分析（含源码分析材料），勿公开该目录
RESUME_ANALYSIS_CACHE_DIR=
RESUME_MAX_REPORTED_TOKENS=250000

# Candidate discovery only; bounded 7000–16000. Actual provider support must be verified.
RESUME_DISCOVERY_MAX_TOKENS=12000
